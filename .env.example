# Universal AI Game Master — environment configuration
# Copy to .env and adjust as needed.

# Application
DEBUG=true
APP_NAME="Universal AI Game Master"

# Database (async SQLite). The file lives under ./data by default.
DATABASE_URL=sqlite+aiosqlite:///./data/universal_gm.db

# Comma-separated list of allowed CORS origins, or * for all.
CORS_ORIGINS=*

# Secret used to derive the encryption key for stored AI API keys.
# CHANGE THIS to a long random string in production.
SECRET_KEY=change-me-in-production-please-set-a-real-secret
